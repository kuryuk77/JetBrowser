<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#FF3A3A3A"/><stroke android:width="3dp" android:color="#FFE53935"/><corners android:radius="16dp"/></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#FF444444"/><corners android:radius="16dp"/></shape>
    </item>
    <item>
        <shape><solid android:color="#FF2A2A2A"/><corners android:radius="16dp"/></shape>
    </item>
</selector>
