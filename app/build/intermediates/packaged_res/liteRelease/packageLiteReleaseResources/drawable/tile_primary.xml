<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item><shape><solid android:color="#55EBC04F"/><corners android:radius="100dp"/></shape></item>
            <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
                <shape><solid android:color="#FFD4A938"/><corners android:radius="100dp"/></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape><solid android:color="#33EBC04F"/><corners android:radius="100dp"/></shape></item>
            <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
                <shape><gradient android:startColor="#FFF2CD62" android:endColor="#FFE2B43F" android:angle="270"/><corners android:radius="100dp"/></shape></item>
        </layer-list>
    </item>
</selector>
